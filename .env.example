# VM settings. Copy to .env and fill in. Keep .env private: chmod 600 .env, never commit it.
# (The Windows PC running MT5 has its own template: deploy/windows/env.windows.example)

# ---------------------------------------------------------------- data
# No keys needed: FX and gold come from Dukascopy's free datafeed, crypto from
# Binance's public market-data host, interest rates from FRED.
# Dukascopy blocks bursts (HTTP 429); keep requests per second low.
DUKASCOPY_RPS=0.5
# How far back the first FX/gold download goes (default 2005-01-01, about 70 minutes).
# Ten years is plenty for the strategies and the ML model, and downloads in about half the time.
DUKASCOPY_START=2016-09-01
# BINANCE_BASE_URL=https://data-api.binance.vision

# ------------------------------------------------------------ messages
# Telegram: message @BotFather, /newbot, paste the token here. Then send your
# bot any message and read chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------- execution
# Orders are placed by the MT5 executor on your PC (deploy/WINDOWS_MT5.md).
# This VM only needs the first key for real money: live.control refuses to
# switch a universe to live mode unless this is exactly "true". The PC's .env
# has a second, independent key.
ALLOW_LIVE_TRADING=false
