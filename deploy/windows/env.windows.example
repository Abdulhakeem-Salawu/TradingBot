# Settings for the WINDOWS PC. setup_executor.ps1 / setup_local.ps1 copy this to .env
# in the project folder. Keep it private; it never leaves this machine.

# ------------------------------------------------------------ where targets come from
# ledger  everything runs on this PC (test phase): paper jobs and the executor share
#         state/ledger.db. Run deploy\windows\setup_local.ps1.
# ssh     the Google VM runs the paper jobs; this PC only executes. Set VM_SSH_TARGET
#         to the host alias printed by `gcloud compute config-ssh`.
TARGETS_SOURCE=ledger
VM_SSH_TARGET=signal-bot.us-central1-a.YOUR_PROJECT_ID
VM_BOT_DIR=~/signal-monitoring

# ----------------------------------------------------------------- prices
# mt5        FX and gold bars from this PC's MetaTrader 5 terminal (fast, no rate limit)
# dukascopy  Dukascopy's free datafeed (what the Linux VM uses)
# Keep one source per ledger.
FX_DATA_SOURCE=mt5
# Years of hourly history to keep (about 20 MB of terminal disk per instrument-year).
MT5_HISTORY_YEARS=10
# Broker clock: auto, ny+7 (MetaQuotes-Demo and most brokers) or utc (Exness)
MT5_SERVER_TZ=auto

# ------------------------------------------------------------------- MT5
# Which slots this executor trades: demo or live. A live terminal needs its own
# copy of this file (e.g. .env.live) and its own scheduled task.
EXECUTOR_MODE=demo
MT5_BACKEND=native
# Pick the terminal when several are installed (e.g. MetaQuotes demo + Exness live).
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Pin the account number: a terminal logged into any other account is refused.
# Recommended for live. The terminal must already be logged in with its password saved;
# MT5_PASSWORD is only needed if you want the executor to log the terminal in itself.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Only if a symbol is not found or several match: canonical:broker pairs.
# Exness symbols carry the account type: EURUSDm (Standard), EURUSDz (Zero), EURUSD (Pro/Raw).
# MT5_SYMBOLS=EUR_USD:EURUSDm,XAU_USD:XAUUSDm
MT5_MAGIC=26091301

# ------------------------------------------------------------------ safety
# The second key for real money on THIS machine (the ledger side has its own).
ALLOW_LIVE_TRADING=false

# Hard limits. Breaching any one blocks EVERY order in that run.
MAX_GROSS_LEVERAGE=1.0
MIN_ORDER_FRACTION=0.02
MAX_TARGET_AGE_MIN=90
# MAX_ORDERS_PER_RUN=

# ------------------------------------------------------------------ messages
# Only needed when this PC runs the paper jobs (TARGETS_SOURCE=ledger); otherwise the VM sends them.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
