# Virtual screen for the MetaTrader 5 terminal (it is a GUI program).
# Installed by deploy/linux/install_mt5_wine.sh, which fills in @USER@.
[Unit]
Description=MT5 virtual display (Xvfb :99)
After=network-online.target

[Service]
User=@USER@
ExecStart=/usr/bin/Xvfb :99 -screen 0 1024x768x16 -nolisten tcp
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
